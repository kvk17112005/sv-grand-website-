# SV Grand API — environment template.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# NOTE: the previously committed `.env.example` contained a live Neon URL and a
# session secret. Those credentials must be ROTATED in Neon / regenerated;
# removing them from the file alone does not revoke them.

# Application database (pooler connection is fine for normal app traffic).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/sv_grand?sslmode=require

# Direct (non-pooler) connection used ONLY by the migration runner and tests.
# Advisory locks and multi-statement transactions require a direct session.
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/sv_grand?sslmode=require

# Isolated database used by the automated test suite. Never point this at live data.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST/sv_grand_test?sslmode=require

PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Public merchant VPA; configured on the backend and never entered by guests.
UPI_MERCHANT_ID=3341101017051@cnrb

# Leave unset until a provider/verified webhook relay has been configured.
# The webhook accepts only a provider-signed HMAC-SHA256 raw JSON body.
PAYMENT_WEBHOOK_SECRET=

# Generate a unique random value of at least 32 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-unique-random-value-at-least-32-characters

# lax for local development, none (with HTTPS) when frontend and API are on different sites.
COOKIE_SAME_SITE=lax
